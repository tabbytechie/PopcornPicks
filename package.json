{
  "name": "popcornpicks",
  "private": true,
  "version": "0.1.0",
  "description": "PopcornPicks - Modular Monolith monorepo (frontend + backend + shared packages + PostgreSQL)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @popcornpicks/frontend",
    "dev:frontend": "npm run dev -w @popcornpicks/frontend",
    "dev:backend": "npm run dev -w @popcornpicks/backend",
    "dev:all": "npm run dev:backend & npm run dev:frontend",
    "build": "npm run build -w @popcornpicks/backend && npm run build -w @popcornpicks/frontend",
    "build:frontend": "npm run build -w @popcornpicks/frontend",
    "build:backend": "npm run build -w @popcornpicks/backend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:boundaries": "npm run lint:boundaries -w @popcornpicks/backend",
    "preview": "npm run preview -w @popcornpicks/frontend",
    "prepare": "husky || true"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
