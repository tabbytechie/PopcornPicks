# PostgreSQL Configuration
POSTGRES_DB=popcornpicks
POSTGRES_USER=popcornpicks
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_PORT=5432

# PostgreSQL Test Database
POSTGRES_TEST_DB=popcornpicks_test

# Application Configuration
NODE_ENV=development
PORT=3001

# Frontend Configuration
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3001

# Admin Configuration
ADMIN_PORT=5174

# TMDB Configuration
TMDB_API_KEY=your_tmdb_api_key_here

# pgAdmin Configuration (Development)
PGADMIN_EMAIL=admin@popcornpicks.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Mailhog Configuration (Development)
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025

# Grafana Configuration (Monitoring)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# SMTP Configuration (Production)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@popcornpicks.com

# Security
JWT_SECRET=change_me_in_production
SESSION_SECRET=change_me_in_production

# External Services
REDIS_URL= # Not used - PostgreSQL only
ELASTICSEARCH_URL= # Not used - PostgreSQL only
