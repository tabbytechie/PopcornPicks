# Production Environment Configuration
# DO NOT commit this file to version control
# Copy from .env.example and set secure values

# PostgreSQL Configuration
POSTGRES_DB=popcornpicks_prod
POSTGRES_USER=popcornpicks
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
POSTGRES_PORT=5432

# Application Configuration
NODE_ENV=production
PORT=3001

# Frontend Configuration
FRONTEND_PORT=80
VITE_API_URL=https://api.popcornpicks.com

# Admin Configuration
ADMIN_PORT=80

# TMDB Configuration
TMDB_API_KEY=CHANGE_ME_TMDB_API_KEY

# SMTP Configuration
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=CHANGE_ME_SENDGRID_API_KEY
SMTP_FROM=noreply@popcornpicks.com

# Security
JWT_SECRET=CHANGE_ME_SECURE_JWT_SECRET_MIN_32_CHARS
SESSION_SECRET=CHANGE_ME_SECURE_SESSION_SECRET_MIN_32_CHARS

# Monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_SECURE_GRAFANA_PASSWORD

# SSL/TLS
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem
